            <column caption="Comparison" datatype="string" name="[estimator_label]" role="dimension" type="nominal" />
            <column-instance column="[estimator_label]" derivation="None" name="[none:estimator_label:nk]" pivot="key" type="nominal" />
            <column caption="Revenue Difference (%)" datatype="real" name="[estimate_ratio]" role="measure" type="quantitative" default-format="p0.0%" />
            <column-instance column="[estimate_ratio]" derivation="Min" name="[min:estimate_ratio:qk]" pivot="key" type="quantitative" />
            <column caption="Outcome Name" datatype="string" name="[outcome_name]" role="dimension" type="nominal" />
            <column-instance column="[outcome_name]" derivation="None" name="[none:outcome_name:nk]" pivot="key" type="nominal" />
