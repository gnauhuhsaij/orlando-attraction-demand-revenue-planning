      <column caption="Predicted Product Share" datatype="real" name="[predicted_product_share]" role="measure" type="quantitative" default-format="p0.0%" />
      <column caption="Predicted Product Demand" datatype="real" name="[predicted_product_demand]" role="measure" type="quantitative" />
      <column caption="Predicted Product Net Yield" datatype="real" name="[predicted_product_net_yield]" role="measure" type="quantitative" default-format="$#,##0.00;($#,##0.00)" />
      <column caption="30-Day Net Revenue ($)" datatype="real" name="[predicted_product_net_revenue]" role="measure" type="quantitative" default-format="$#,##0.00;($#,##0.00)" />
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic" show-structure="true" />
      <object-graph>
        <objects>
          <object caption="Product" id="PRODUCT_TABLE">
            <properties context="">
              <relation connection="textscan.orlando_product" name="product.csv" table="[product#csv]" type="table">
                <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
                  <column datatype="string" name="target_date" ordinal="0" />
                  <column datatype="string" name="product_name" ordinal="1" />
                  <column datatype="string" name="ticket_tier" ordinal="2" />
                  <column datatype="real" name="base_price" ordinal="3" />
                  <column datatype="real" name="predicted_product_share" ordinal="4" />
                  <column datatype="real" name="predicted_product_demand" ordinal="5" />
                  <column datatype="real" name="predicted_product_net_yield" ordinal="6" />
                  <column datatype="real" name="predicted_product_net_revenue" ordinal="7" />
                </columns>
              </relation>
            </properties>
          </object>
        </objects>
      </object-graph>
    </datasource>
