            <column-instance column="[period_name]" derivation="None" name="[none:period_name:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.orlando_campaign].[none:outcome_name:nk]">
            <groupfilter function="member" level="[none:outcome_name:nk]" member="&quot;net_revenue&quot;" user:ui-domain="relevant" user:ui-enumeration="inclusive" />
          </filter>
          <filter class="categorical" column="[federated.orlando_campaign].[none:period_name:nk]">
            <groupfilter function="member" level="[none:period_name:nk]" member="&quot;campaign_window&quot;" user:ui-domain="relevant" user:ui-enumeration="inclusive" />
          </filter>
